# Placeholders only. Do not put real keys in this file or commit a filled-in .env.
# Unit 1 does not read any API key. PeopleGroups.org is public.

# Optional. In-memory cache lifetime for PeopleGroups.org responses, in seconds.
# Default 600, matching the Cache-Control max-age observed on the public API.
# The cache is not written to disk. Set to 0 to disable it.
PEOPLEGROUPS_CACHE_TTL_SECONDS=600

# Optional. Pause between paged PeopleGroups.org requests, in milliseconds.
# Default 150.
PEOPLEGROUPS_PAGE_DELAY_MS=150

# Unit 2. Bible Brain key. Zach requests this from Faith Comes By Hearing.
# Leave blank until a key exists. The adapter stays off while this is empty.
BIBLE_BRAIN_API_KEY=

# Unit 2. Global Recordings Network key. A church or ministry applies.
# Leave blank until a key exists. The adapter stays off while this is empty.
GRN_API_KEY=

# Unit 3. Joshua Project key. Free, non-commercial, Zach requests it.
# Leave blank until a key exists. The adapter stays off while this is empty.
JOSHUA_PROJECT_API_KEY=

# Unit 6. Vercel AI Gateway key for the on-site chat agent.
# Leave blank in the repo. Set it only in the host's secret store.
AI_GATEWAY_API_KEY=

# Unit 6. Requests per minute for one client of the public chat agent.
CHAT_RATE_LIMIT_PER_MINUTE=20
